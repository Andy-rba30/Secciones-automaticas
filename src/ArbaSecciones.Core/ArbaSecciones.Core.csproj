    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ArbaSecciones.Core</RootNamespace>
    <AssemblyName>ArbaSecciones.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ArbaSecciones.Core.Tests" />
  </ItemGroup>

</Project>
